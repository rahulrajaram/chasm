table inet chasm {
    chain input {
        type filter hook input priority -10; policy accept;

        iifname "@BRIDGE_NAME@" meta nfproto ipv6 counter drop
        iifname "@BRIDGE_NAME@" udp dport { 53, 67 } accept
        iifname "@BRIDGE_NAME@" tcp dport 53 accept
        iifname "@BRIDGE_NAME@" counter drop
    }

    chain forward {
        type filter hook forward priority -10; policy accept;

        iifname "@BRIDGE_NAME@" meta nfproto ipv6 counter drop
        iifname "@BRIDGE_NAME@" ct state invalid counter drop
        iifname "@BRIDGE_NAME@" ip daddr {
            0.0.0.0/8,
            10.0.0.0/8,
            100.64.0.0/10,
            127.0.0.0/8,
            169.254.0.0/16,
            172.16.0.0/12,
            192.0.0.0/24,
            192.0.2.0/24,
            192.168.0.0/16,
            198.18.0.0/15,
            198.51.100.0/24,
            203.0.113.0/24,
            224.0.0.0/4
        } counter drop
    }
}
