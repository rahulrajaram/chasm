[Unit]
Description=chasm unprivileged workflow supervisor
ConditionPathExists=@SITE_MARKER_PATH@
Requires=chasm-executor.socket
After=chasm-executor.socket

[Service]
Type=simple
User=@SUPERVISOR_USER@
Group=@SUPERVISOR_USER@
ExecStart=/usr/local/libexec/chasm/supervisor_server --state-root /var/lib/chasm/supervisor --executor-socket /run/chasm-executor.sock
Restart=on-failure
RestartSec=2s
UMask=0077
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/chasm/supervisor
ProtectHome=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectKernelLogs=yes
ProtectProc=invisible
ProcSubset=pid
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
TasksMax=32
MemoryMax=128M
